{
  "manifest_version": 3,
  "name": "Bookmarks Manager ",
  "version": "1.0.0",
  "description": "A minimalist bookmarks and tabs manager.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Bookmarks Manager"
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "activeTab"
  ]
}